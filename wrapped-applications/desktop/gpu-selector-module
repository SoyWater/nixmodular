{ config, pkgs, ... }:
{
  constructFiles.niri-gpu-selector = {
    relPath = "bin/niri-gpu-selector";
    content = ''
      #!${pkgs.runtimeShell}
      connector_status_file=/sys/class/drm/card0-HDMI-A-1/status
      config_directory="$HOME/.config/niri"
      config_file="$config_directory/gpu.kdl"

      if [ -r "$connector_status_file" ] && [ "$(${pkgs.coreutils}/bin/tr -d '[:space:]' < "$connector_status_file")" = connected ]; then
        selected_gpu=nvidia
        render_device=/dev/dri/by-path/pci-0000:02:00.0-render
      else
        selected_gpu=intel
        render_device=/dev/dri/by-path/pci-0000:00:02.0-render
      fi

      ${pkgs.coreutils}/bin/mkdir -p "$config_directory"
      temporary_config=$(${pkgs.coreutils}/bin/mktemp "$config_directory/.gpu.kdl.XXXXXX")
      trap '${pkgs.coreutils}/bin/rm -f "$temporary_config"' EXIT
      printf 'debug {\n    render-drm-device "%s"\n}\n' "$render_device" > "$temporary_config"
      ${pkgs.coreutils}/bin/mv -f "$temporary_config" "$config_file"
      trap - EXIT

      printf 'niri-gpu-selector: HDMI-A-1 is %s; selected %s (%s)\n' \
        "$(${pkgs.coreutils}/bin/tr -d '[:space:]' < "$connector_status_file" 2>/dev/null || printf 'unknown')" \
        "$selected_gpu" \
        "$render_device" >&2
    '';
    builder = ''
      cp "$1" "$2"
      chmod +x "$2"
    '';
  };

  runShell = [ config.constructFiles.niri-gpu-selector.path ];
}
