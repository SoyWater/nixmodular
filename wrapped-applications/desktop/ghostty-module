{ config, inputs, lib, pkgs, wlib, defaultDesktopConfigHome, ... }:
let
  desktopConfigHome = config._module.args.desktopConfigHome or defaultDesktopConfigHome;
in
{
  wrapperVariants.ghostty = {
    mirror = false;
    package = inputs.self.packages.${pkgs.stdenv.hostPlatform.system}.ghostty.wrap {
      env.XDG_CONFIG_HOME = lib.mkForce (wlib.mkOutOfStoreSymlink pkgs desktopConfigHome);
    };
  };
}
