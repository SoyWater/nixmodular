{ inputs, pkgs, ... }:
let
  vicinaeConfig = "/home/soywater/nixconfigs/wrapped-applications/desktop/config/vicinae/settings.json";
in
{
  # The settings file remains user-writable for GUI changes. Keep it outside
  # the Nix store so Vicinae can use atomic saves.
  extraSettings = [
    { "spawn-at-startup" = [ "vicinae" "server" "--config" vicinaeConfig ]; }
    { include = ./config/vicinae/vicinae.kdl; }
  ];

  wrapperVariants.vicinae = {
    mirror = false;
    package = inputs.self.packages.${pkgs.stdenv.hostPlatform.system}.vicinae;
  };
}
