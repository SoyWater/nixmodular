{ config, inputs, pkgs, defaultDesktopConfigHome, ... }:
let
  desktopConfigHome = config._module.args.desktopConfigHome or defaultDesktopConfigHome;
  vicinaeConfig = "${desktopConfigHome}/vicinae/settings.json";
in
{
  # The settings file remains user-writable for GUI changes. Keep it outside
  # the Nix store so Vicinae can use atomic saves.
  extraSettings = [
    { "spawn-at-startup" = [ "vicinae" "server" "--config" vicinaeConfig ]; }
    { include = ./config/vicinae/vicinae.kdl; }
  ];

  constructFiles.vicinae = {
    relPath = "bin/vicinae";
    content = "${inputs.self.packages.${pkgs.stdenv.hostPlatform.system}.vicinae}/bin/vicinae";
    builder = ''ln -s "$(cat "$1")" "$2"'';
  };
}
