{ inputs, pkgs, desktopConfigHome, ... }:
let
  vicinaeConfig = "${desktopConfigHome}/wrapped-applications/desktop/config/vicinae/settings.json";
in
{
  # The settings file remains user-writable for GUI changes. Keep it outside
  # the Nix store so Vicinae can use atomic saves.
  extraSettings = [
    { "spawn-at-startup" = [ "vicinae" "server" "--config" vicinaeConfig ]; }
    { include = ./config/vicinae/vicinae.kdl; }
  ];

  constructFiles.vicinae = {
    relPath = "bin/vicinae";
    content = "${inputs.self.packages.${pkgs.stdenv.hostPlatform.system}.vicinae.wrap {
      _module.args.desktopConfigHome = desktopConfigHome;
    }}/bin/vicinae";
    builder = ''ln -s "$(cat "$1")" "$2"'';
  };
}
