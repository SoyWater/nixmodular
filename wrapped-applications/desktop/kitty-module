{ inputs, pkgs, desktopConfigHome, ... }:
{
  constructFiles.kitty = {
    relPath = "bin/kitty";
    content = "${inputs.self.packages.${pkgs.stdenv.hostPlatform.system}.kitty.wrap {
      _module.args.desktopConfigHome = desktopConfigHome;
    }}/bin/kitty";
    builder = ''ln -s "$(cat "$1")" "$2"'';
  };
}
