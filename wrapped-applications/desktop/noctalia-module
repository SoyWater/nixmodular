{ inputs, pkgs, wlib, ... }:
let
  noctaliaConfigDir = "/home/soywater/nixconfigs/wrapped-applications/desktop/config";
  noctaliaNiriConfig = wlib.mkOutOfStoreSymlink pkgs "${noctaliaConfigDir}/noctalia/noctalia.kdl";
in
{
  extraSettings = [
    {
      include = [
        { optional = true; }
        (toString noctaliaNiriConfig)
      ];
    }
    {
      include = [
        { optional = true; }
        "~/.local/state/noctalia/themes/niri/noctalia.kdl"
      ];
    }
  ];

  wrapperVariants.noctalia = {
    mirror = false;
    package = inputs.self.packages.${pkgs.stdenv.hostPlatform.system}.noctalia;
  };

}
