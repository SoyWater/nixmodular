{ inputs, pkgs, wlib, desktopConfigHome, desktopTempHome, ... }:
let
  noctaliaNiriConfig = wlib.mkOutOfStoreSymlink pkgs "${desktopConfigHome}/wrapped-applications/desktop/config/noctalia/noctalia.kdl";
in
{
  extraSettings = [
    {
      include = [
        { optional = true; }
        (toString noctaliaNiriConfig)
      ];
    }
    {
      include = [
        { optional = true; }
        "${desktopTempHome}/noctalia/themes/niri/noctalia.kdl"
      ];
    }
  ];

  constructFiles.noctalia = {
    relPath = "bin/noctalia";
    content = "${inputs.self.packages.${pkgs.stdenv.hostPlatform.system}.noctalia.wrap {
      _module.args.desktopConfigHome = desktopConfigHome;
      _module.args.desktopTempHome = desktopTempHome;
    }}/bin/noctalia";
    builder = ''ln -s "$(cat "$1")" "$2"'';
  };
}
