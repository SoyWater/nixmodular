{ inputs }:
{ lib, pkgs, wlib, ... }:
let
  system = pkgs.stdenv.hostPlatform.system;
  noctaliaPackage = inputs.noctalia.packages.${system}.default;
  vicinaePackage = inputs.vicinae.packages.${system}.default;
  noctaliaConfigDir = "/home/soywater/nixconfigs/wrapped-applications/desktop/config/noctalia";
  noctaliaConfigHome = wlib.mkOutOfStoreSymlink pkgs noctaliaConfigDir;
  noctaliaNiriConfig = wlib.mkOutOfStoreSymlink pkgs (
    "${noctaliaConfigDir}/noctalia.kdl"
  );
  addDesktopBinToPath = [
    {
      name = "desktop-bin-path";
      data = ''
        export PATH="$(dirname "$0")''${PATH:+:$PATH}"
      '';
    }
  ];
in
{
  extraSettings = [
    {
      include = [
        { optional = true; }
        (toString noctaliaNiriConfig)
      ];
    }
  ];
  runShell = addDesktopBinToPath;

  wrapperVariants.noctalia = {
    mirror = false;
    package = noctaliaPackage;
    env.NOCTALIA_CONFIG_HOME = noctaliaConfigHome;
    runShell = addDesktopBinToPath;
  };

  wrapperVariants.vicinae = {
    mirror = false;
    package = vicinaePackage;
    runShell = addDesktopBinToPath;
  };
}
