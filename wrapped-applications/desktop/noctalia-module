{ config, inputs, lib, pkgs, wlib, defaultDesktopConfigHome, ... }:
let
  desktopConfigHome = config._module.args.desktopConfigHome or defaultDesktopConfigHome;
  noctaliaNiriConfig = wlib.mkOutOfStoreSymlink pkgs "${desktopConfigHome}/noctalia/noctalia.kdl";
in
{
  extraSettings = [
    {
      include = [
        { optional = true; }
        (toString noctaliaNiriConfig)
      ];
    }
    {
      include = [
        { optional = true; }
        "~/.local/state/noctalia/themes/niri/noctalia.kdl"
      ];
    }
  ];

  constructFiles.noctalia = {
    relPath = "bin/noctalia";
    content = "${inputs.self.packages.${pkgs.stdenv.hostPlatform.system}.noctalia.wrap {
      env.NOCTALIA_CONFIG_HOME = lib.mkForce (wlib.mkOutOfStoreSymlink pkgs desktopConfigHome);
    }}/bin/noctalia";
    builder = ''ln -s "$(cat "$1")" "$2"'';
  };
}
