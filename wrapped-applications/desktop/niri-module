{ lib, pkgs, wlib, ... }:
let
  niriConfigDir = "/home/soywater/nixconfigs/wrapped-applications/desktop/config/niri";
  niriStaticIncludes = map (path: wlib.mkOutOfStoreSymlink pkgs path) [
    "${niriConfigDir}/config.kdl"
    "${niriConfigDir}/monitors.kdl"
    "${niriConfigDir}/inputs.kdl"
    "${niriConfigDir}/binds.kdl"
  ];
in
{
  package = pkgs.niri;

  # The included KDL files intentionally live outside the Nix store, so niri's
  # build-time validation sandbox cannot read them.
  disableConfigValidation = true;

  runtimePkgs = [ pkgs.xwayland-satellite ];
  env = {
    XCURSOR_THEME = "Bibata-Modern-Ice";
    XCURSOR_SIZE = "24";
    XCURSOR_PATH = "${pkgs.bibata-cursors}/share/icons";
  };
  extraSettings =
    map (path: { include = toString path; }) niriStaticIncludes;

  passthru.cargoBuildNoDefaultFeatures = pkgs.niri.cargoBuildNoDefaultFeatures;
  passthru.cargoBuildFeatures = pkgs.niri.cargoBuildFeatures;
  meta.platforms = lib.platforms.linux;
}
