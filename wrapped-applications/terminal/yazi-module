{ lib, pkgs, ... }:
{
  terminalFish.functions = lib.mkAfter [
    ''
      function y
        set -l cwd_file (mktemp -t yazi-cwd.XXXXXX)
        command yazi $argv --cwd-file="$cwd_file"
        if read -z cwd < "$cwd_file"; and test -n "$cwd"; and test "$cwd" != "$PWD"
          builtin cd -- "$cwd"
        end
        rm -f -- "$cwd_file"
      end

      function yy
        y $argv
      end
    ''
  ];
  constructFiles.yazi = {
    relPath = "bin/yazi";
    content = "${pkgs.yazi}/bin/yazi";
    builder = ''ln -s "$(cat "$1")" "$2"'';
  };
}
