{ pkgs, ... }:
{
  constructFiles.niri-force-kill-picked-window = {
    relPath = "bin/niri-force-kill-picked-window";
    content = ''
      #!${pkgs.runtimeShell}
      set -eu

      selection="$(''${placeholder "out"}/bin/niri msg pick-window 2>/dev/null || true)"
      pid="$(printf '%s\n' "$selection" | ${pkgs.gnugrep}/bin/grep -m1 -oE 'PID:[[:space:]]*[0-9]+' | ${pkgs.gnugrep}/bin/grep -oE '[0-9]+$' || true)"

      case "$pid" in
        ""|*[!0-9]*)
          exit 0
          ;;
      esac

      if [ "$pid" -le 1 ]; then
        exit 0
      fi

      kill -KILL -- "$pid" 2>/dev/null || true
    '';
    builder = ''
      cp "$1" "$2"
      chmod +x "$2"
    '';
  };
}
