{
   "$schema": "https://vicinae.com/schemas/config.json",
   "theme": {
      "dark": {
         "name": "matugen"
      }
   },
   "providers": {
      "applications": {
         "entrypoints": {
            "fcitx5-configtool": {
               "enabled": false
            },
            "khal": {
               "enabled": false
            },
            "org.fcitx.Fcitx5": {
               "enabled": false
            },
            "org.fcitx.fcitx5-migrator": {
               "enabled": false
            }
         }
      },
      "browser-extension": {
         "entrypoints": {
            "browse-tabs": {
               "enabled": false
            },
            "shortcut-active-tab": {
               "enabled": false
            }
         }
      },
      "font": {
         "entrypoints": {
            "browse": {
               "enabled": false
            }
         }
      },
      "theme": {
         "entrypoints": {
            "set": {
               "enabled": false
            }
         }
      }
   }
}
